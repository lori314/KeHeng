# Copy to backend/.env for local use. Keep real credentials out of version control.
KEHENG_AGENT_MODE=rule
KEHENG_RETRIEVAL_MODE=hash
KEHENG_LLM_ENDPOINT=
KEHENG_LLM_MODEL=
KEHENG_LLM_API_KEY=
KEHENG_LLM_TIMEOUT_SECONDS=120
# Optional: leave empty to omit enable_thinking; otherwise set true or false.
KEHENG_LLM_ENABLE_THINKING=
KEHENG_WEB_SEARCH_PROVIDER=
KEHENG_TAVILY_API_KEY=
KEHENG_TAVILY_SEARCH_DEPTH=advanced
KEHENG_WEB_SEARCH_TIMEOUT_SECONDS=30
